{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "npx --version": "allow",
      "npx playwright *": "allow",
      "npm run *": "allow",
      "echo \"started pid: $!\"": "allow"
    },
    "read": {
      "/home/fnd/.cache/ms-playwright/**": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "artefact-graph": {
      "type": "local",
      "command": ["node", "mcp/server.mjs", "--corpus=artefacts"],
      "enabled": true
    }
  }
}
