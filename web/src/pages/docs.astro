            { name: "code-review", desc: "Code review: IoC, RESTful, Contracts, Security (OWASP), Clean Architecture, SOLID" },
            { name: "feature-discovery", desc: "Discovery process, codebase analysis" },
            { name: "feature-specification", desc: "Single writer of about.md - reads the brainstorm intent file, extracts the objective and the closed decisions without asking, and asks only what is still open. Loaded by /add-new." },
            { name: "architecture-discovery", desc: "Use when documenting project architecture - generates Technical Spec section in AGENTS.md" },
            { name: "delivery-validation", desc: "Product validation: Requirements 100% implemented, prerequisites exist, acceptance criteria pass" },
            { name: "subagent-driven-development", desc: "Coordinate subagents with quality gates" },
            { name: "add--tasks-checklist", desc: "Use when generating, reading, or ticking tasks.md — defines the canonical 5-section schema, tick rules per section, failure marker semantics, 'non-trivial change' rule, and the architect subagent prompt template" },
            { name: "token-efficiency", desc: "Use when creating commands, skills, or docs - defines generic compression patterns (minified JSON, abbreviations, glob patterns, single breaks). Load before any write where token density matters." },
            { name: "commit", desc: "Smart commit with auto-generated Conventional Commits messages" },
            { name: "health-check", desc: "Tech health check suite: docs, security, architecture, data analysis" },
            { name: "dev-environment-setup", desc: "Use when Node, git or gh CLI are missing, or Node is older than 22.19.0 - detects OS, diagnoses gaps, installs missing tools." },
            { name: "backend-architecture", desc: "Guides backend architecture decisions - over-engineering, folder structure, slices, layers, feature organization, where code goes." },
            { name: "frontend-architecture", desc: "Frontend architecture consultant for project structure, folder organization, feature boundaries, and scaling decisions. Framework-aware (React, Vue, Angular). Use when user asks about frontend folder structure, \"components folder is a mess\", \"where should this go\", over-engineering, slices, feature folders, or starting/refactoring a frontend project. Guides decisions only - does not implement (use add--frontend-development) or design UI (use ux-design)." },
            { name: "ecosystem", desc: "ADD ecosystem map and framework overview" },
