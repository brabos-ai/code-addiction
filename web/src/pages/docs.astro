      <p class="font-mono text-accent text-xs tracking-widest uppercase">{t("docs.search.title")}</p>
      <button type="button" id="docs-search-close" class="text-muted-light hover:text-foreground text-sm" aria-label={t("docs.search.close")}>Esc</button>
    </div>
    <div id="docs-search-ui"></div>
    <p id="docs-search-fallback" class="hidden text-sm text-muted-light" set:html={t("docs.search.fallback")} />
  </dialog>
  <script type="application/json" id="docs-i18n" set:html={clientStringsJson} />

  <script is:inline>
    function initDocsChrome() {
    // This script stays on the document after a client-side navigation to another page.
    if (!document.getElementById('docs-sidebar')) return;
    const pageAbort = new AbortController();
    document.addEventListener('astro:before-swap', () => pageAbort.abort(), { once: true });
    // Read on every page load: the next page may be the other language.
    const i18nEl = document.getElementById('docs-i18n');
    const S = i18nEl ? JSON.parse(i18nEl.textContent) : {};
    const sidebarToggle = document.getElementById('docs-sidebar-toggle');
    const sidebar = document.getElementById('docs-sidebar');
    const backdrop = document.getElementById('docs-backdrop');
    const sidebarLinks = sidebar.querySelectorAll('a');

    function toggleSidebar() {
      const isClosed = sidebar.classList.contains('-translate-x-full');
      sidebarToggle.setAttribute('aria-expanded', String(isClosed));
      if (isClosed) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    if (sidebarToggle && sidebar && backdrop) {
      sidebarToggle.addEventListener('click', toggleSidebar);
      backdrop.addEventListener('click', toggleSidebar);

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !sidebar.classList.contains('-translate-x-full') && window.innerWidth < 1024) {
          toggleSidebar();
          sidebarToggle.focus();
        }
      }, { signal: pageAbort.signal });

      sidebarLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 1024) {
            toggleSidebar();
          }
        });
      });
    }

    // Docs search. The Pagefind UI is built into dist/pagefind by `npm run build`, so it is
    // fetched on first open instead of weighing down every page view.
    (function () {
      var dialog = document.getElementById('docs-search');
      var openers = [document.getElementById('docs-search-open'), document.getElementById('docs-search-open-mobile')];
      var closeBtn = document.getElementById('docs-search-close');
      if (!dialog || typeof dialog.showModal !== 'function') return;
      var loaded = false;
      var ui = null;
      // The Pagefind UI belongs to this page's dialog. Destroy it before the swap so the next page
      // builds a fresh one, which loads the index for the new <html lang>.
      pageAbort.signal.addEventListener('abort', function () {
        if (ui && typeof ui.destroy === 'function') ui.destroy();
        ui = null;
      });
      function mountUi() {
        ui = new window.PagefindUI({ element: '#docs-search-ui', showSubResults: true, showImages: false, resetStyles: false, translations: S.pagefind || {} });
        var input = dialog.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }
      function loadUi() {
        if (loaded) return;
        loaded = true;
        if (window.PagefindUI) { mountUi(); return; }
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
        var js = document.createElement('script');
        js.src = '/pagefind/pagefind-ui.js';
        js.onload = mountUi;
        js.onerror = function () {
          loaded = false;
          document.getElementById('docs-search-fallback').classList.remove('hidden');
        };
        document.head.appendChild(js);
      }
      function openSearch() {
        if (!dialog.open) dialog.showModal();
        loadUi();
        var input = dialog.querySelector('.pagefind-ui__search-input');
        if (input) input.focus();
      }
      openers.forEach(function (b) { if (b) b.addEventListener('click', openSearch); });
      if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
      // A click on the dialog itself (outside its content) is a backdrop click.
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog) { dialog.close(); return; }
        // Picking a result follows its link; the dialog should not stay over the page.
        if (event.target.closest && event.target.closest('a')) dialog.close();
      });
      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          openSearch();
        }
      }, { signal: pageAbort.signal });
    })();

    // Scroll-spy: the sidebar link of the section being read carries aria-current.
    if ('IntersectionObserver' in window) {
      const spyLinks = new Map();
      sidebarLinks.forEach(link => {
        const hash = link.getAttribute('href');
        if (hash && hash.startsWith('#')) spyLinks.set(hash.slice(1), link);
      });
      const setCurrent = (id) => {
        spyLinks.forEach((link, key) => {
          if (key === id) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      };
      const spy = new IntersectionObserver((entries) => {
        // The band is a thin strip near the top, so one section crosses it at a time.
        entries.forEach(entry => { if (entry.isIntersecting) setCurrent(entry.target.id); });
      }, { rootMargin: '-72px 0px -75% 0px' });
      document.querySelectorAll('section[id]').forEach(section => spy.observe(section));
    }
    }
    document.addEventListener('astro:page-load', initDocsChrome);
  </script>

  <style is:global>
    .eco-list-item--active { background: rgba(255,255,255,0.06); }
