  <!-- Docs search: Pagefind UI, loaded on first open -->
  <dialog id="docs-search" aria-label={t("docs.search.title")} class="m-auto mt-20 w-[min(42rem,calc(100vw-2rem))] max-h-[80vh] overflow-y-auto rounded-xl border border-white/10 bg-[#0a0a0f] p-4 text-foreground backdrop:bg-black/70">
