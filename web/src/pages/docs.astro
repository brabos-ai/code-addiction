---
import Layout from "../layouts/Layout.astro";
import CommandLine from "../components/CommandLine.astro";
import { providers, installDirs } from "../data/providers";
import LanguageToggle from "../components/LanguageToggle.astro";
import { useT, localeHref, type NamedEntry } from "../i18n";
import "../styles/global.css";

const locale = Astro.currentLocale ?? "en";
const t = useT(locale);

type ScenarioEntry = { badge: string; title: string; desc: string; steps: { cmd: string; text: string }[] };
// Badge colour per scenario, and colour of each step's command (visual only, not copy).
const scenarioTone = ["accent", "accent", "accent", "amber", "red", "accent"];
const scenarioStepTone = [
  ["accent", "accent", "accent", "accent", "accent", "accent"],
  ["accent", "accent", "accent", "accent"],
  ["accent", "accent", "accent"],
  ["amber", "amber", "accent"],
  ["red", "accent"],
  ["accent", "accent"],
];
// Commands each optional feature is injected into: artefact names, never translated.
const featureTargets: Record<string, string[]> = {
  "tdd-pipeline": ["add-plan", "add-build", "add-review", "add-hotfix"],
  "qa-pipeline": ["add-plan", "add-build", "add-review"],
  "docs-pruning": ["add-done"],
  board: ["add-brainstorm", "add-new", "add-plan", "add-build", "add-done", "add-hotfix"],
  "agent-mode": ["add-brainstorm", "add-new", "add-plan", "add-build", "add-review", "add-done", "add-diagnose", "add-hotfix", "add-qa-setup", "add-pull-request", "add-audit", "add-wiki"],
};

// Plugin cards name the commands and agents they touch: artefact names, never translated.
const codeList = (names: string[]) => names.map((n) => `<code class="font-mono">${n}</code>`).join(", ");
const gitnexusCommands = ["add-new", "add-plan", "add-build", "add-diagnose", "add-hotfix", "add-done", "add-wiki"];

// Everything the inline scripts print or set. Rendered once into #docs-i18n; the scripts re-read it
// on every astro:page-load, so a client-side switch between /docs/ and /pt-br/docs/ changes language.
const clientStrings = {
  searchTitle: t("docs.search.title"),
  pagefind: {
    placeholder: t("docs.search.placeholder"),
    clear_search: t("docs.search.clearSearch"),
    load_more: t("docs.search.loadMore"),
    search_label: t("docs.search.searchLabel"),
    zero_results: t("docs.search.zeroResults"),
    many_results: t("docs.search.manyResults"),
    one_result: t("docs.search.oneResult"),
    alt_search: t("docs.search.altSearch"),
    search_suggestion: t("docs.search.searchSuggestion"),
    searching: t("docs.search.searching"),
  },
  graphError: t("docs.graph.error"),
  ecoError: t("docs.ecosystem.loadError"),
  ecoLoadsDispatches: t("docs.ecosystem.loadsDispatches"),
  ecoUsedBy: t("docs.ecosystem.usedByPanel"),
  ecoTypes: { command: t("docs.ecosystem.typeCommand"), skill: t("docs.ecosystem.typeSkill"), agent: t("docs.ecosystem.typeAgent") },
  ecoGroups: { command: t("docs.ecosystem.commands"), skill: t("docs.ecosystem.skills"), agent: t("docs.ecosystem.agents") },
};
const clientStringsJson = JSON.stringify(clientStrings).replace(/</g, "\\u003c");
---

<Layout title={t("docs.title")}>
  <!-- Nav -->
  <nav transition:name="site-nav" class="fixed top-0 w-full z-50 backdrop-blur-md bg-surface/80 border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="docs-sidebar-toggle" class="lg:hidden p-1 -ml-1 text-muted-light hover:text-foreground" aria-label={t("docs.nav.toggleSidebar")} aria-controls="docs-sidebar" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <a href={localeHref(locale, "")} class="font-display font-bold text-foreground tracking-tight text-lg">
          <span class="text-accent">+</span> code addiction
        </a>
      </div>
      <div class="hidden md:flex items-center gap-6">
        <button type="button" id="docs-search-open" class="flex items-center gap-2 text-sm text-muted-light hover:text-accent border border-white/10 hover:border-accent/30 rounded-md px-3 py-1.5 transition-colors" aria-keyshortcuts="Control+K Meta+K"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg><span>{t("docs.nav.search")}</span><kbd aria-hidden="true" class="font-mono text-xs text-muted border border-white/10 rounded px-1.5">Ctrl K</kbd></button>
        <a href={localeHref(locale, "")} class="text-sm text-muted-light hover:text-accent transition-colors">{t("docs.nav.home")}</a>
        <LanguageToggle />
        <a href="https://github.com/brabos-ai/code-addiction" target="_blank" rel="noopener" class="text-sm text-surface bg-accent hover:bg-accent-dim font-mono font-medium px-4 py-1.5 rounded-md transition-colors">
          {t("docs.nav.github")}
        </a>
      </div>
      <div class="flex md:hidden items-center gap-2">
        <button type="button" id="docs-search-open-mobile" class="md:hidden flex items-center gap-2 text-sm text-muted-light hover:text-accent border border-white/10 hover:border-accent/30 rounded-md px-3 py-1.5 transition-colors" aria-label={t("docs.nav.searchAria")} aria-keyshortcuts="Control+K Meta+K"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"/></svg></button>
        <a href="https://github.com/brabos-ai/code-addiction" target="_blank" rel="noopener" class="text-sm text-surface bg-accent hover:bg-accent-dim font-mono font-medium px-3 py-1.5 rounded-md transition-colors">
          {t("docs.nav.github")}
        </a>
      </div>
    </div>
  </nav>

  <!-- Mobile Backdrop -->
  <div id="docs-backdrop" class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity"></div>

  <div class="flex pt-14">
    <!-- Sidebar -->
    <aside id="docs-sidebar" class="fixed top-14 left-0 w-64 h-[calc(100vh-3.5rem)] overflow-y-auto border-r border-white/5 bg-surface z-50 px-6 py-8 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
      <nav class="space-y-6 text-sm">
        <LanguageToggle class="pb-2" />
        <div class="lg:hidden pb-2 mb-2">
          <a href={localeHref(locale, "")} class="flex items-center gap-2 text-accent hover:text-accent-dim transition-colors font-medium">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            {t("docs.sidebar.backToHome")}
          </a>
        </div>
        <div>
          <p class="font-mono text-accent text-xs tracking-widest uppercase mb-3">{t("docs.sidebar.groups.gettingStarted")}</p>
          <ul class="space-y-2">
            <li><a href="#about" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.about")}</a></li>
            <li><a href="#install" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.install")}</a></li>
            <li><a href="#quickstart" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.quickstart")}</a></li>
            <li><a href="#setup" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.setup")}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-mono text-accent text-xs tracking-widest uppercase mb-3">{t("docs.sidebar.groups.reference")}</p>
          <ul class="space-y-2">
            <li><a href="#commands" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.commands")}</a></li>
            <li><a href="#graph" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.graph")}</a></li>
            <li><a href="#flows" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.flows")}</a></li>
            <li><a href="#scenarios" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.scenarios")}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-mono text-accent text-xs tracking-widest uppercase mb-3">{t("docs.sidebar.groups.deepDive")}</p>
          <ul class="space-y-2">
            <li><a href="#skills" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.skills")}</a></li>
            <li><a href="#features" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.features")}</a></li>
            <li><a href="#agent-mode" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.agentMode")}</a></li>
            <li><a href="#plugins" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.plugins")}</a></li>
            <li><a href="#providers" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.providers")}</a></li>
            <li><a href="#structure" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.structure")}</a></li>
            <li><a href="#ecosystem" class="text-muted-light hover:text-foreground transition-colors">{t("docs.sidebar.items.ecosystem")}</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="flex-1 lg:ml-64 min-w-0 px-6 sm:px-12 py-12 max-w-4xl" data-pagefind-body>

      <!-- ABOUT -->
      <section id="about" class="mb-20">
        <p class="font-mono text-accent text-xs tracking-widest uppercase mb-4">{t("docs.sidebar.groups.gettingStarted")}</p>
        <h1 id="about-heading" class="font-display font-extrabold text-4xl sm:text-5xl mb-6" set:html={t("docs.about.heading")} />
        <p class="text-muted-light text-lg leading-relaxed mb-6">{t("docs.about.intro")}</p>
        <div class="grid sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-lg border border-white/5 bg-white/[0.02]">
            <div class="text-accent font-mono text-sm mb-2">.codeadd/</div>
            <p class="text-muted-light text-sm">{t("docs.about.coreDesc")}</p>
          </div>
          <div class="p-4 rounded-lg border border-white/5 bg-white/[0.02]">
            <div class="text-accent font-mono text-sm mb-2">{t("docs.about.adaptersTitle")}</div>
            <p class="text-muted-light text-sm">Claude, Codex, Antigravity, Cursor, OpenCode, ZCode</p>
          </div>
          <div class="p-4 rounded-lg border border-white/5 bg-white/[0.02]">
            <div class="text-accent font-mono text-sm mb-2">codeadd CLI</div>
            <p class="text-muted-light text-sm">install, update, uninstall, doctor, validate, features, plugins, providers, modify, config</p>
          </div>
        </div>
      </section>

      <!-- INSTALL -->
      <section id="install" class="mb-20">
        <h2 id="install-heading" class="font-display font-bold text-2xl sm:text-3xl mb-6">{t("docs.install.heading")}</h2>
        <p class="text-muted-light mb-6" set:html={t("docs.install.requirements")} />

        <div class="bg-white/[0.03] border border-white/10 rounded-xl p-6 font-mono text-sm space-y-3">
          <div><span class="text-muted select-none">{t("docs.install.commentInstall")}</span></div>
          <CommandLine command="npx codeadd install" bare />
          <div class="pt-2"><span class="text-muted select-none">{t("docs.install.commentVersion")}</span></div>
          <CommandLine command="npx codeadd install --version v2.0.1" bare />
          <div class="pt-2"><span class="text-muted select-none">{t("docs.install.commentBranch")}</span></div>
          <CommandLine command="npx codeadd install --branch feature-xyz" bare />
          <div class="pt-2"><span class="text-muted select-none">{t("docs.install.commentExisting")}</span></div>
          <CommandLine command="npx codeadd install" bare />
        </div>

        <h3 class="font-display font-semibold text-lg mt-8 mb-4">{t("docs.install.whatInstalled")}</h3>
        <div class="bg-white/[0.03] border border-white/10 rounded-xl p-6 font-mono text-sm leading-relaxed">
          <span class="text-muted">your-project/</span><br/>
          <span class="text-accent">├── .codeadd/</span><span class="text-muted ml-6">← {t("docs.install.coreAlways")}</span><br/>
          {installDirs().map((row, i, all) => (
            <>
              <span class="text-foreground inline-block min-w-[11ch]">{i === all.length - 1 ? "└── " : "├── "}{row.dir}</span><span class="text-muted">← {row.labels.join(" + ")}</span>{i < all.length - 1 && <br/>}
            </>
          ))}
        </div>

        <p class="text-muted text-sm mt-4" set:html={t("docs.install.scriptsNote")} />
      </section>

      <!-- QUICKSTART -->
      <section id="quickstart" class="mb-20">
        <h2 id="quickstart-heading" class="font-display font-bold text-2xl sm:text-3xl mb-6">{t("docs.quickstart.heading")}</h2>
        <p class="text-muted-light mb-6">{t("docs.quickstart.intro")}</p>

        <div class="space-y-3">
          {t<NamedEntry[]>("docs.quickstart.items").map((item) => (
            <div class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4 p-4 rounded-lg border border-white/5 bg-white/[0.02]">
              <CommandLine command={item.name} bare class="sm:shrink-0" />
              <span class="text-muted-light text-sm" set:html={item.desc} />
            </div>
          ))}
        </div>
      </section>

      <!-- Divider -->
      <div class="border-t border-white/5 my-16"></div>

      <!-- SETUP -->
      <section id="setup" class="mb-20">
        <h2 id="setup-heading" class="font-display font-bold text-2xl sm:text-3xl mb-4">{t("docs.setup.heading")}</h2>
        <p class="text-muted-light mb-6" set:html={t("docs.setup.intro")} />

        <div class="grid sm:grid-cols-3 gap-4 mb-6">
          {t<{ title: string; desc: string }[]>("docs.setup.steps").map((step) => (
            <div class="p-4 rounded-lg border border-white/5 bg-white/[0.02]">
              <div class="text-accent font-mono text-sm mb-2" set:html={step.title} />
              <p class="text-muted-light text-sm" set:html={step.desc} />
            </div>
          ))}
        </div>

        <div class="space-y-3">
          {t<{ label: string; desc: string }[]>("docs.setup.rows").map((row) => (
            <div class="flex items-start gap-4 p-4 rounded-lg border border-white/5 bg-white/[0.02]">
              <span class="text-accent font-mono text-sm whitespace-nowrap">{row.label}</span>
              <span class="text-muted-light text-sm" set:html={row.desc} />
            </div>
          ))}
        </div>
      </section>

      <!-- COMMANDS -->
      <section id="commands" class="mb-20">
        <p class="font-mono text-accent text-xs tracking-widest uppercase mb-4">{t("docs.sidebar.groups.reference")}</p>
        <h2 id="commands-heading" class="font-display font-bold text-2xl sm:text-3xl mb-4">{t("docs.commands.heading")}</h2>
        <p class="text-muted-light mb-8">{t("docs.commands.intro")}</p>

        <!-- Commands Map -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-12">
          {t<{ title: string; items: NamedEntry[] }[]>("docs.commands.groups").map((group) => (
            <div class="rounded-xl border border-white/5 bg-white/[0.015] p-5">
              <h3 class="font-display font-bold text-xs tracking-widest uppercase text-foreground mb-4">{group.title}</h3>
              <div class="space-y-2.5">
                {group.items.map((cmd) => (
                  <div class="rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2.5 hover:border-accent/20 transition-colors">
                    {cmd.name === "/add-setup" ? (
                      <a href="#setup" class="text-accent font-mono text-sm underline underline-offset-2 hover:text-accent-dim">{cmd.name}</a>
                    ) : cmd.name === "/add-hotfix" ? (
                      <code class="text-accent font-mono text-sm" style="color:#ff4444">{cmd.name}</code>
                    ) : (
                      <code class="text-accent font-mono text-sm">{cmd.name}</code>
                    )}
                    <p class="text-muted text-xs mt-0.5" set:html={cmd.desc} />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Divider -->
      <div class="border-t border-white/5 my-16"></div>

      <!-- ARTEFACT GRAPH -->
      <section id="graph" class="mb-20">
        <p class="font-mono text-accent text-xs tracking-widest uppercase mb-4">{t("docs.sidebar.groups.reference")}</p>
        <h2 id="graph-heading" class="font-display font-bold text-2xl sm:text-3xl mb-4">{t("docs.graph.heading")}</h2>
        <p class="text-muted-light mb-8" set:html={t("docs.graph.intro1")} />
        <p class="text-muted-light mb-8" set:html={t("docs.graph.intro2")} />

        <div class="overflow-x-auto rounded-lg border border-white/5 bg-surface p-4">
          <pre class="mermaid" id="artefact-graph" set:html={t("docs.graph.loading")} />
        </div>

        <p class="text-muted-light text-sm mt-4" set:html={t("docs.graph.query")} />
      </section>

      <!-- Divider -->
      <div class="border-t border-white/5 my-16"></div>

      <!-- FLOWS -->
      <section id="flows" class="mb-20">
        <p class="font-mono text-accent text-xs tracking-widest uppercase mb-4">{t("docs.sidebar.groups.reference")}</p>
        <h2 id="flows-heading" class="font-display font-bold text-2xl sm:text-3xl mb-4">{t("docs.flows.heading")}</h2>
        <p class="text-muted-light mb-8">{t("docs.flows.intro")}</p>

        <!-- Flows HTML -->
        <div class="space-y-10">

          <!-- Complete -->
          <div>
            <h3 class="font-display font-bold text-sm tracking-widest uppercase mb-1">{t("docs.flows.complete.title")}</h3>
            <p class="text-muted text-xs mb-4">{t("docs.flows.complete.desc")}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flow-node">{t("docs.flows.nodes.brainstorm")}<br/><span class="flow-cmd">/add-brainstorm</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.new")}<br/><span class="flow-cmd">/add-new</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.plan")}<br/><span class="flow-cmd">/add-plan</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.code")}<br/><span class="flow-cmd">/add-build</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.check")}<br/><span class="flow-cmd">/add-review</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.done")}<br/><span class="flow-cmd">/add-done</span></span>
            </div>
          </div>

          <!-- Standard -->
          <div>
            <h3 class="font-display font-bold text-sm tracking-widest uppercase mb-1">{t("docs.flows.standard.title")}</h3>
            <p class="text-muted text-xs mb-4">{t("docs.flows.standard.desc")}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flow-node">{t("docs.flows.nodes.new")}<br/><span class="flow-cmd">/add-new</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.plan")}<br/><span class="flow-cmd">/add-plan</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.code")}<br/><span class="flow-cmd">/add-build</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.done")}<br/><span class="flow-cmd">/add-done</span></span>
            </div>
          </div>

          <!-- Lean -->
          <div>
            <h3 class="font-display font-bold text-sm tracking-widest uppercase mb-1">{t("docs.flows.lean.title")}</h3>
            <p class="text-muted text-xs mb-4">{t("docs.flows.lean.desc")}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flow-node">{t("docs.flows.nodes.new")}<br/><span class="flow-cmd">/add-new</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.code")}<br/><span class="flow-cmd">/add-build</span></span>
              <span class="flow-arrow">→</span>
              <span class="flow-node">{t("docs.flows.nodes.done")}<br/><span class="flow-cmd">/add-done</span></span>
            </div>
          </div>

          <!-- Convergence -->
          <div>
            <h3 class="font-display font-bold text-sm tracking-widest uppercase mb-1" style="color:#ffaa00">{t("docs.flows.automatic.title")}</h3>
            <p class="text-muted text-xs mb-4">{t("docs.flows.automatic.desc")}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flow-node">{t("docs.flows.nodes.brainstorm")}<br/><span class="flow-cmd">/add-brainstorm</span></span>
              <span class="flow-arrow" style="color:#ffaa00">→</span>
              <span class="flow-node">{t("docs.flows.nodes.new")}<br/><span class="flow-cmd">/add-new</span></span>
              <span class="flow-arrow" style="color:#ffaa00">→</span>
              <span class="flow-node">{t("docs.flows.nodes.plan")}<br/><span class="flow-cmd">/add-plan</span></span>
              <span class="flow-arrow" style="color:#ffaa00">→</span>
              <span class="flow-node" style="border-color:#ffaa00;background:rgba(255,170,0,0.05)">{t("docs.flows.nodes.buildFinal")}<br/><span class="flow-cmd" style="color:#ffaa00">/add-build</span></span>
              <span class="flow-arrow" style="color:#ffaa00">→</span>
              <span class="flow-node">{t("docs.flows.nodes.prQuestion")}</span>
            </div>
          </div>

          <!-- Emergency -->
          <div>
            <h3 class="font-display font-bold text-sm tracking-widest uppercase mb-1" style="color:#ff4444">{t("docs.flows.emergency.title")}</h3>
            <p class="text-muted text-xs mb-4">{t("docs.flows.emergency.desc")}</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flow-node" style="border-color:#ff4444;background:rgba(255,68,68,0.05)">{t("docs.flows.nodes.hotfix")}<br/><span class="flow-cmd" style="color:#ff4444">/add-hotfix</span></span>
