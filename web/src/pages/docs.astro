        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { name: "backend-development", desc: "SOLID, Clean Arch, DTOs, Services, Repository — stack-agnostic" },
            { name: "frontend-development", desc: "State, data fetching, components, forms, routing — stack-agnostic" },
            { name: "database-development", desc: "Entities, repositories, migrations, naming — stack-agnostic" },
