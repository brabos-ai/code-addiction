  <script is:inline>
  function initEcoMap() {
    // Read on every page load: the next page may be the other language.
    var i18nEl = document.getElementById('docs-i18n');
    var S = i18nEl ? JSON.parse(i18nEl.textContent) : {};
    var ecoAbort = new AbortController();
    document.addEventListener('astro:before-swap', function () { ecoAbort.abort(); }, { once: true });
    var CYTOSCAPE_CDN = 'https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.30.2/cytoscape.min.js';
    var LAYOUT_BASE_CDN = 'https://cdn.jsdelivr.net/npm/layout-base@2.0.1/layout-base.min.js';
    var COSE_BASE_CDN = 'https://cdn.jsdelivr.net/npm/cose-base@2.2.0/cose-base.min.js';
    var COSE_BILKENT_CDN = 'https://cdn.jsdelivr.net/npm/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.min.js';

    function loadScript(src) {
      return new Promise(function(res, rej) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = res;
        s.onerror = rej;
        document.head.appendChild(s);
      });
    }

    // The map is generated: node scripts/graph.js ecosystem --write emits
    // web/public/ecosystem.json from the build sidecar. Never hand-edit it.
    function initEcosystem(eco) {
      // The reader may have navigated away while Cytoscape and the data were loading.
      if (!document.getElementById('eco-cy')) return;
      var nodes = eco.nodes;
      var edges = eco.edges;

      // Compute degree (connection count) per node for size scaling
      var degreeMap = {};
      edges.forEach(function(e) {
        degreeMap[e.data.source] = (degreeMap[e.data.source] || 0) + 1;
        degreeMap[e.data.target] = (degreeMap[e.data.target] || 0) + 1;
      });
      nodes.forEach(function(n) {
        n.data.degree = degreeMap[n.data.id] || 1;
      });

      var cy = window.__ecoCy = window.cytoscape({
        container: document.getElementById('eco-cy'),
        elements: { nodes: nodes, edges: edges },
        wheelSensitivity: 0.2,
        style: [
          {
            selector: 'node',
            style: {
              'label': '',
              'font-size': 10,
              'font-family': 'ui-sans-serif, system-ui, sans-serif',
              'text-valign': 'bottom',
              'text-halign': 'center',
              'text-margin-y': 6,
              'color': '#cbd5e1',
              'text-wrap': 'wrap',
              'text-max-width': 140,
              'text-outline-color': '#0a0a0f',
              'text-outline-width': 2,
              'shape': 'ellipse',
              'width': 'mapData(degree, 1, 12, 10, 38)',
              'height': 'mapData(degree, 1, 12, 10, 38)',
              'border-width': 0,
              'transition-property': 'background-color, border-width, width, height',
              'transition-duration': '120ms',
            }
          },
          {
            selector: 'node.show-label',
            style: { 'label': 'data(label)' }
          },
          {
            selector: 'node[type="command"]',
            style: {
              'background-color': '#a78bfa',
              'label': 'data(label)',
            }
          },
          {
            selector: 'node[type="skill"]',
            style: {
              'background-color': '#22d3ee',
            }
          },
          {
            selector: 'node[type="agent"]',
            style: {
              'background-color': '#34d399',
            }
          },
          {
            selector: 'node.highlighted',
            style: {
              'border-width': 2,
              'border-color': '#ffffff',
              'border-opacity': 0.85,
              'color': '#f1f5f9',
              'font-size': 11,
              'z-index': 999,
            }
          },
          {
            selector: 'edge',
            style: {
              'width': 0.8,
              'line-color': '#334155',
              'curve-style': 'bezier',
              'opacity': 0.55,
              'target-arrow-shape': 'none',
            }
          },
          {
            selector: 'edge.highlighted',
            style: {
              'width': 1.4,
              'line-color': '#cbd5e1',
              'opacity': 1,
              'z-index': 998,
            }
          },
          {
            selector: '.faded',
            style: {'opacity': 0.08}
          },
          {
            selector: '.hidden-node',
            style: {'display': 'none'}
          },
        ],
        layout: {
          name: 'cose-bilkent',
          quality: 'proof',
          nodeDimensionsIncludeLabels: false,
          fit: true,
          padding: 60,
          randomize: true,
          nodeRepulsion: 6500,
          idealEdgeLength: 85,
          edgeElasticity: 0.45,
          nestingFactor: 0.1,
          gravity: 0.9,
          numIter: 3500,
          tile: true,
          tilingPaddingVertical: 6,
          tilingPaddingHorizontal: 6,
          gravityRangeCompound: 1.5,
          gravityCompound: 1.0,
          gravityRange: 1.2,
          initialEnergyOnIncremental: 0.5,
          animate: false,
        }
      });

      // Pull disconnected components close to the main cluster centroid.
      // cose-bilkent tiles orphans on the side; we re-center them so they
      // don't visually drift away from the graph.
      cy.ready(function() {
        var components = cy.elements().components();
        if (components.length <= 1) return;
        // Largest component is treated as the "main" cluster
        var main = components.reduce(function(a, b) { return a.length >= b.length ? a : b; });
        var bb = main.boundingBox();
        var cx = bb.x1 + bb.w / 2;
        var cy1 = bb.y1 + bb.h / 2;
        components.forEach(function(comp) {
          if (comp === main) return;
          var cb = comp.boundingBox();
          var ccx = cb.x1 + cb.w / 2;
          var ccy = cb.y1 + cb.h / 2;
          // Pick the closest edge of the main bbox + a small gap
          var gap = 80;
          var targetX, targetY;
          if (Math.abs(ccx - cx) > Math.abs(ccy - cy1)) {
            targetX = ccx < cx ? bb.x1 - gap : bb.x2 + gap;
            targetY = cy1;
          } else {
            targetX = cx;
            targetY = ccy < cy1 ? bb.y1 - gap : bb.y2 + gap;
          }
          var dx = targetX - ccx;
          var dy = targetY - ccy;
          comp.nodes().forEach(function(n) {
            var p = n.position();
            n.position({ x: p.x + dx, y: p.y + dy });
          });
        });
        cy.fit(cy.elements(), 50);
      });

      // ----- Helpers shared between graph + list -----
      function highlightNode(id) {
        var n = cy.getElementById(id);
        if (!n || n.empty()) return;
        // Always reset state first so successive highlights don't accumulate
        cy.elements().removeClass('faded').removeClass('highlighted').removeClass('show-label');
        var hood = n.closedNeighborhood();
        cy.elements().not(hood).addClass('faded');
        hood.addClass('highlighted');
        hood.nodes().addClass('show-label');
        document.querySelectorAll('.eco-list-item').forEach(function(el) {
          el.classList.toggle('eco-list-item--active', el.dataset.id === id);
        });
      }
      function clearHighlight() {
        cy.elements().removeClass('faded').removeClass('highlighted');
        if (cy.zoom() < 1.1) cy.nodes().removeClass('show-label');
        document.querySelectorAll('.eco-list-item--active').forEach(function(el) {
          el.classList.remove('eco-list-item--active');
        });
      }
      // Reduced motion: the map still moves, it just does not animate.
      function motionMs(ms) {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : ms;
      }
      function focusNode(id) {
        var n = cy.getElementById(id);
        if (!n || n.empty()) return;
        cy.stop(true, true);
        cy.animate({ center: { eles: n }, zoom: Math.max(cy.zoom(), 1.4) }, { duration: motionMs(350) });
        showInspect(n);
        highlightNode(id);
      }
      function showInspect(n) {
        var inspect = document.getElementById('eco-inspect');
        document.getElementById('eco-panel-name').textContent = n.data('id');
        var typeEl = document.getElementById('eco-panel-type');
        typeEl.textContent = (S.ecoTypes && S.ecoTypes[n.data('type')]) || n.data('type');
        typeEl.style.color = TYPE_COLOR[n.data('type')] || '#cbd5e1';
        var out = n.outgoers('node');
        var inc = n.incomers('node');
        var html = '';
        if (out.length) {
          html += '<div><span class="text-foreground font-mono text-xs uppercase tracking-wide">' + S.ecoLoadsDispatches + '</span><ul class="mt-1 space-y-0.5">';
          out.each(function(x) { html += '<li class="font-mono text-xs truncate hover:text-foreground cursor-pointer eco-link" data-id="' + x.id() + '">' + x.id() + '</li>'; });
          html += '</ul></div>';
        }
        if (inc.length) {
          html += '<div><span class="text-foreground font-mono text-xs uppercase tracking-wide">' + S.ecoUsedBy + '</span><ul class="mt-1 space-y-0.5">';
          inc.each(function(x) { html += '<li class="font-mono text-xs truncate hover:text-foreground cursor-pointer eco-link" data-id="' + x.id() + '">' + x.id() + '</li>'; });
          html += '</ul></div>';
        }
        document.getElementById('eco-panel-body').innerHTML = html;
        inspect.classList.remove('hidden');
        // Wire link clicks inside inspect to focus
        inspect.querySelectorAll('.eco-link').forEach(function(li) {
          li.addEventListener('click', function() { focusNode(li.dataset.id); });
        });
      }
      var TYPE_COLOR = { command: '#a78bfa', skill: '#22d3ee', agent: '#34d399' };

      // Hover: highlight neighborhood + reveal labels (Obsidian-style)
      cy.on('mouseover', 'node', function(e) { highlightNode(e.target.id()); });
      cy.on('mouseout', 'node', function() { clearHighlight(); });

      // ----- Browse sidebar: render lists -----
      var browseEl = document.getElementById('eco-browse');
      var GROUPS = [
        { type: 'command', label: S.ecoGroups.command, color: TYPE_COLOR.command, collapsed: false },
        { type: 'skill', label: S.ecoGroups.skill, color: TYPE_COLOR.skill, collapsed: true },
        { type: 'agent', label: S.ecoGroups.agent, color: TYPE_COLOR.agent, collapsed: true },
      ];
      browseEl.innerHTML = GROUPS.map(function(g) {
        var items = nodes.filter(function(n) { return n.data.type === g.type; })
          .sort(function(a, b) { return a.data.id.localeCompare(b.data.id); });
        var lis = items.map(function(n) {
          return '<li class="eco-list-item flex items-center gap-2 px-2 py-1 rounded cursor-pointer hover:bg-white/[0.04] transition-colors" data-id="' + n.data.id + '">' +
            '<span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:' + g.color + '"></span>' +
            '<span class="font-mono text-[11px] text-muted-light truncate">' + n.data.id + '</span></li>';
        }).join('');
        var collapsedAttr = g.collapsed ? 'true' : 'false';
        var listStyle = g.collapsed ? ' style="display:none"' : '';
        var chevStyle = g.collapsed ? ' style="transform:rotate(-90deg)"' : '';
        return '<div data-type="' + g.type + '" data-collapsed="' + collapsedAttr + '">' +
          '<button type="button" class="eco-group-toggle font-mono text-xs uppercase tracking-widest mb-1.5 px-2 w-full flex items-center justify-between hover:bg-white/[0.03] rounded py-0.5 transition-colors" style="color:' + g.color + '">' +
            '<span class="flex items-center gap-1.5">' +
              '<svg class="eco-chevron w-2.5 h-2.5 transition-transform"' + chevStyle + ' fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/></svg>' +
              g.label +
            '</span><span class="text-muted" data-count>' + items.length + '</span>' +
          '</button>' +
          '<ul class="eco-group-list space-y-px"' + listStyle + '>' + lis + '</ul></div>';
      }).join('');

      // List item interactions — click only (hover does nothing, per UX feedback)
      browseEl.addEventListener('click', function(e) {
        var toggle = e.target.closest('.eco-group-toggle');
        if (toggle) {
          var group = toggle.parentElement;
          var collapsed = group.dataset.collapsed === 'true';
          group.dataset.collapsed = collapsed ? 'false' : 'true';
          var list = group.querySelector('.eco-group-list');
          var chev = group.querySelector('.eco-chevron');
          if (list) list.style.display = collapsed ? '' : 'none';
          if (chev) chev.style.transform = collapsed ? '' : 'rotate(-90deg)';
          return;
        }
        var li = e.target.closest('.eco-list-item');
        if (li) focusNode(li.dataset.id);
      });

      // Zoom: progressively reveal labels
      cy.on('zoom', function() {
        var z = cy.zoom();
        if (z >= 1.1) {
          cy.nodes().addClass('show-label');
        } else {
          cy.nodes().removeClass('show-label');
        }
      });

      // Click node: open inspect
      cy.on('tap', 'node', function(e) { showInspect(e.target); });

      document.getElementById('eco-panel-close').addEventListener('click', function() {
        document.getElementById('eco-inspect').classList.add('hidden');
      });

      // ----- Sidebar list filter (type + search) -----
      var listState = { filter: 'all', query: '' };
      function applyListFilter() {
        var q = listState.query;
        var f = listState.filter;
        var total = 0;
        document.querySelectorAll('#eco-browse > div').forEach(function(group) {
          var groupType = group.dataset.type;
          var groupVisible = (f === 'all' || f === groupType);
          var visibleCount = 0;
          group.querySelectorAll('.eco-list-item').forEach(function(li) {
            var match = groupVisible && (!q || li.dataset.id.toLowerCase().indexOf(q) !== -1);
            li.style.display = match ? '' : 'none';
            if (match) visibleCount++;
          });
          group.style.display = (groupVisible && visibleCount > 0) ? '' : 'none';
          var countEl = group.querySelector('[data-count]');
          if (countEl) countEl.textContent = visibleCount;
          total += visibleCount;
        });
        document.getElementById('eco-empty').classList.toggle('hidden', total > 0);
      }

      document.querySelectorAll('.eco-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.eco-btn').forEach(function(b) {
            b.className = 'eco-btn text-xs px-3 py-1 rounded-md border border-white/10 text-muted-light hover:text-foreground font-mono';
          });
          this.className = 'eco-btn text-xs px-3 py-1 rounded-md border border-accent bg-accent text-surface font-mono';
          listState.filter = this.dataset.filter;
          applyListFilter();
        });
      });

      document.getElementById('eco-search').addEventListener('input', function() {
        listState.query = this.value.trim().toLowerCase();
        applyListFilter();
      });

      // ----- Graph controls -----
      function zoomBy(factor) {
        var z = cy.zoom() * factor;
        cy.animate({ zoom: { level: z, position: { x: cy.width()/2, y: cy.height()/2 } } }, { duration: motionMs(180) });
      }
      document.getElementById('eco-zoom-in').addEventListener('click', function() { zoomBy(1.3); });
      document.getElementById('eco-zoom-out').addEventListener('click', function() { zoomBy(1/1.3); });
      document.getElementById('eco-fit').addEventListener('click', function() {
        cy.stop(true, true);
        cy.elements().removeClass('faded').removeClass('highlighted').removeClass('show-label');
        document.querySelectorAll('.eco-list-item--active').forEach(function(el) { el.classList.remove('eco-list-item--active'); });
        document.getElementById('eco-inspect').classList.add('hidden');
        cy.animate({ fit: { eles: cy.elements(), padding: 50 } }, { duration: motionMs(350) });
      });

      var wrap = document.getElementById('eco-graph-wrap');
      var fsIcon = document.getElementById('eco-fs-icon');
      var ICON_FS = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M16 4h4v4M4 16v4h4M16 20h4v-4"/>';
      var ICON_EXIT = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9V4M9 9H4M15 9V4M15 9h5M9 15v5M9 15H4M15 15v5M15 15h5"/>';
      function toggleFullscreen() {
        var entering = !wrap.classList.contains('is-fullscreen');
        wrap.classList.toggle('is-fullscreen', entering);
        fsIcon.innerHTML = entering ? ICON_EXIT : ICON_FS;
        document.body.style.overflow = entering ? 'hidden' : '';
        // Resize cy to new container, then refit
        setTimeout(function() {
          cy.resize();
          cy.fit(cy.elements(), 50);
        }, 60);
      }
      document.getElementById('eco-fullscreen').addEventListener('click', toggleFullscreen);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && wrap.classList.contains('is-fullscreen')) toggleFullscreen();
      }, { signal: ecoAbort.signal });
    }

    // Lazy-load Cytoscape when section scrolls into view
    var section = document.getElementById('ecosystem');
    if (!section) return;
    var observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) {
        observer.disconnect();
        var chain = window.cytoscape
          ? Promise.resolve()
          : loadScript(CYTOSCAPE_CDN);
        chain
          .then(function() { return loadScript(LAYOUT_BASE_CDN); })
          .then(function() { return loadScript(COSE_BASE_CDN); })
          .then(function() { return loadScript(COSE_BILKENT_CDN); })
          .then(function() {
            return fetch('/ecosystem.json').then(function(r) {
              if (!r.ok) throw new Error('HTTP ' + r.status);
              return r.json();
            });
          })
          .then(initEcosystem)
          .catch(function(err) {
            console.error('Ecosystem load failed:', err);
            // Say what happened. A silent blank panel reads as a broken site.
            var box = document.getElementById('eco-cy');
            if (box) box.textContent = S.ecoError.replace('{error}', err.message);
          });
      }
    }, { rootMargin: '300px' });
    observer.observe(section);
  }
  document.addEventListener('astro:page-load', initEcoMap);
  </script>

  <!--
    Artefact graph — rendered from web/public/artefact-graph.mmd, which
    `node scripts/graph.js mermaid --write` generates from the build-emitted
    graph. A test asserts the checked-in file matches what the current graph
    produces, so a stale diagram fails CI rather than shipping to the docs.

    Loaded lazily: mermaid is ~1MB and most visitors never scroll here.
  -->
  <script is:inline>
  function initMermaidGraph() {
    // Read on every page load: the next page may be the other language.
    var i18nEl = document.getElementById('docs-i18n');
    var S = i18nEl ? JSON.parse(i18nEl.textContent) : {};
    var section = document.getElementById('graph');
    var target = document.getElementById('artefact-graph');
    if (!section || !target) return;

    var started = false;

    function render() {
      if (started) return;
      started = true;

      fetch('/artefact-graph.mmd')
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.text();
        })
        .then(function (src) {
          // The reader may have navigated away while the file was loading.
          if (!target.isConnected) return;
          target.textContent = src;
          var s = document.createElement('script');
          s.type = 'module';
          // Pinned: an unpinned mermaid has changed its default theme and its
          // flowchart parser between minors before now.
          s.textContent =
            "import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs';" +
            "mermaid.initialize({ startOnLoad: false, theme: 'base', securityLevel: 'strict', themeVariables: {" +
            "background: '#050505', primaryColor: '#0b1f17', primaryTextColor: '#e8e8e8', primaryBorderColor: '#00ff88'," +
            "secondaryColor: '#111111', tertiaryColor: '#050505', lineColor: '#00cc6a', textColor: '#e8e8e8'," +
            "fontFamily: '\"Outfit Variable\", Outfit, sans-serif' } });" +
            "var graphNode = document.getElementById('artefact-graph');" +
            "if (graphNode) Promise.resolve(mermaid.run({ nodes: [graphNode] })).catch(function (e) { console.warn('Diagram render skipped', e); });";
          document.body.appendChild(s);
        })
        .catch(function (e) {
          // Say what happened. A silent blank panel reads as a broken site.
          target.textContent = S.graphError.replace('{error}', e.message);
        });
    }

    var observer = new IntersectionObserver(function (entries) {
      if (entries.some(function (e) { return e.isIntersecting; })) {
        render();
        observer.disconnect();
      }
    }, { rootMargin: '300px' });
    observer.observe(section);
  }
  document.addEventListener('astro:page-load', initMermaidGraph);
  </script>
  <style is:global>
    section[id] { scroll-margin-top: 4.5rem; }
  </style>
</Layout>
